rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        request.auth.token.email == 'anavneeraj2003@gmail.com'
      );
    }

    // Allows initial database setup if settings document does not exist yet
    function isBootstrap() {
      return !exists(/databases/$(database)/documents/settings/global-settings);
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Admins collection
    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Users collection
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) || isAdmin();
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
    }

    // Categories (Publicly readable, manageable)
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if true;
    }

    // Products (Publicly readable, manageable)
    match /products/{productId} {
      allow read: if true;
      allow write: if true;
    }

    // Reviews (Publicly readable, signed in users can create, owner/admin can manage)
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update, delete: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
    }

    // Settings (Publicly readable, manageable)
    match /settings/{settingsId} {
      allow read: if true;
      allow write: if true;
    }

    // Orders (Customer can create, store managers & customer tracking allowed to read, update status & tracking)
    match /orders/{orderId} {
      allow read: if true; // Allows order listing for admin dashboard and customer order tracking
      allow create: if true; // Allows authenticated and guest checkout
      allow update: if true; // Allows order status updates, courier tracking numbers and payment state
      allow delete: if isAdmin();
    }

    // Test connection doc
    match /test/connection {
      allow read: if true;
    }

    // Admin audit logs
    match /admin_audit_logs/{logId} {
      allow read, write: if true;
    }
  }
}
