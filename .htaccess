<IfModule mod_mime.c>
  AddType video/mp4 .mp4
  AddType video/webm .webm
  AddType video/ogg .ogv
  AddType video/quicktime .mov
  AddType image/webp .webp
  AddType image/jpeg .jpg .jpeg
  AddType image/png .png
  AddType image/svg+xml .svg
  AddType application/json .json
  AddType application/javascript .js .mjs
  AddType text/css .css
  AddType font/woff .woff
  AddType font/woff2 .woff2
  AddType font/ttf .ttf
  <Files "products">
    ForceType application/json
  </Files>
  <Files "orders">
    ForceType application/json
  </Files>
</IfModule>

# Disable gzip compression for video files to enable HTTP 206 Partial Content (Byte Range requests) in Safari & Chrome
<IfModule mod_deflate.c>
  SetEnvIfNoCase Request_URI \.(?:mp4|webm|ogv|mov)$ no-gzip dont-vary
</IfModule>

# Streaming headers, Byte-Range support and CORS for media
<IfModule mod_headers.c>
  Header set Accept-Ranges bytes
  <FilesMatch "\.(mp4|webm|mov|ogv)$">
    Header set Access-Control-Allow-Origin "*"
    Header set Access-Control-Allow-Methods "GET, HEAD, OPTIONS"
    Header set Access-Control-Allow-Headers "Range, Accept-Encoding"
    Header set Access-Control-Expose-Headers "Content-Range, Content-Length, Accept-Ranges"
    Header set Accept-Ranges bytes
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "^index\.html$">
    Header set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
    Header set Pragma "no-cache"
  </FilesMatch>
</IfModule>

# SPA routing with media file exclusion (never return HTML for missing or direct media requests)
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Route dynamic products API requests to PHP handler BEFORE physical file check (api/products static file exists)
  RewriteRule ^api/products/?$ /api/products.php [QSA,L]
  RewriteRule ^api/products/([^/]+)/?$ /api/products.php?id=$1 [QSA,L]

  # Serve existing physical files and directories directly
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Admin & Media API routes on Hostinger Apache
  RewriteRule ^api/admin/login/?$ /api/admin/login.php [QSA,L]
  RewriteRule ^api/admin/verify-session/?$ /api/admin/verify-session.php [QSA,L]
  RewriteRule ^api/admin/logout/?$ /api/admin/logout.php [QSA,L]
  RewriteRule ^api/videos/upload/?$ /api/videos/upload.php [QSA,L]

  # Media and asset files must never fall back to index.html (return 404 instead of HTML)
  RewriteCond %{REQUEST_URI} \.(mp4|webm|ogv|mov|jpg|jpeg|png|gif|webp|svg|ico|css|js|json|woff|woff2|ttf|eot)$ [NC]
  RewriteRule .* - [R=404,L]

  # API requests must NEVER fall back to index.html (return 404 instead of HTML)
  RewriteCond %{REQUEST_URI} ^/api/ [NC]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^api/.* - [R=404,L]

  # Direct pass for index.html
  RewriteRule ^index\.html$ - [L]

  # Route all other routes to index.html SPA
  RewriteRule . /index.html [L]
</IfModule>

