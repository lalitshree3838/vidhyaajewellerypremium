# Prevent Apache content-negotiation from bypassing rewrite rules (e.g., /api/orders -> orders.php)
<IfModule mod_negotiation.c>
  Options -MultiViews
</IfModule>

<IfModule mod_mime.c>
  AddType video/mp4 .mp4
  AddType video/webm .webm
  AddType video/ogg .ogv
  AddType video/quicktime .mov
  AddType image/webp .webp
  AddType image/jpeg .jpg .jpeg
  AddType image/png .png
  AddType image/svg+xml .svg
  AddType application/json .json
  AddType application/javascript .js .mjs
  AddType text/css .css
  AddType font/woff .woff
  AddType font/woff2 .woff2
  AddType font/ttf .ttf
</IfModule>

# Pass Authorization header through CGI/FastCGI/LSAPI environments on Hostinger Apache
<IfModule mod_setenvif.c>
  SetEnvIfNoCase ^Authorization$ "(.+)" HTTP_AUTHORIZATION=$1
</IfModule>

# Disable gzip compression for video files to enable HTTP 206 Partial Content (Byte Range requests) in Safari & Chrome
<IfModule mod_deflate.c>
  SetEnvIfNoCase Request_URI \.(?:mp4|webm|ogv|mov)$ no-gzip dont-vary
</IfModule>

# Streaming headers, Byte-Range support and CORS for media
<IfModule mod_headers.c>
  Header set Accept-Ranges bytes
  <FilesMatch "\.(mp4|webm|mov|ogv)$">
    Header set Access-Control-Allow-Origin "*"
    Header set Access-Control-Allow-Methods "GET, HEAD, OPTIONS"
    Header set Access-Control-Allow-Headers "Range, Accept-Encoding"
    Header set Access-Control-Expose-Headers "Content-Range, Content-Length, Accept-Ranges"
    Header set Accept-Ranges bytes
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "^index\.html$">
    Header set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
    Header set Pragma "no-cache"
  </FilesMatch>
</IfModule>

# Protect sensitive directories, internal includes, and secret/PII files from direct public HTTP access
<FilesMatch "^(cashfree-config\.json|sms-config\.json|admin-credentials\.json|admin-auth\.json|_auth\.php|\.env(\..*)?|orders|patrons\.json|orders\.json|backup_orders.*\.json|whatsapp_logs\.json)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

# SPA routing with media file exclusion and secure PHP API routing
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Preserve Authorization header in mod_rewrite server environment
  RewriteCond %{HTTP:Authorization} .
  RewriteRule ^ - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

  # Deny direct HTTP access to .admin-secrets, .backups, internal PHP helpers, and private data JSON files
  RewriteRule ^(\.admin-secrets|\.backups)(/.*)?$ - [F,L]
  RewriteRule ^api/admin/_ - [F,L]
  RewriteRule ^data/(orders|patrons|whatsapp_logs|backup_orders.*)\.json$ - [F,L]
  RewriteRule ^(cashfree-config|sms-config|admin-credentials|admin-auth)\.json$ - [F,L]

  # Route dynamic products, orders, auth & videos API requests to PHP handlers BEFORE physical file checks
  RewriteRule ^api/products/?$ /api/products.php [QSA,L]
  RewriteRule ^api/products/([^/]+)/?$ /api/products.php?id=$1 [QSA,L]
  RewriteRule ^api/orders/?$ /api/orders.php [QSA,L]
  RewriteRule ^api/orders/([^/]+)/confirm-payment/?$ /api/orders.php?id=$1&action=confirm-payment [QSA,L]
  RewriteRule ^api/orders/([^/]+)/customer-whatsapp-confirm/?$ /api/orders.php?id=$1&action=customer-whatsapp-confirm [QSA,L]
  RewriteRule ^api/orders/([^/]+)/whatsapp-confirm/?$ /api/orders.php?id=$1&action=customer-whatsapp-confirm [QSA,L]
  RewriteRule ^api/orders/([^/]+)/?$ /api/orders.php?id=$1 [QSA,L]

  # Mobile customer auth & video inventory routes
  RewriteRule ^api/auth/mobile-register/?$ /api/auth/mobile.php?action=register [QSA,L]
  RewriteRule ^api/auth/mobile-login/?$ /api/auth/mobile.php?action=login [QSA,L]
  RewriteRule ^api/videos/available/?$ /api/videos/available.php [QSA,L]
  RewriteRule ^api/media/available/?$ /api/media/available.php [QSA,L]

  # Cashfree PG & Webhook routes
  RewriteRule ^api/payments/cashfree/status/?$ /api/payments/cashfree.php?action=status [QSA,L]
  RewriteRule ^api/payments/cashfree/create-order/?$ /api/payments/cashfree.php?action=create-order [QSA,L]
  RewriteRule ^api/payments/cashfree/verify-order/?$ /api/payments/cashfree.php?action=verify-order [QSA,L]
  RewriteRule ^api/payments/cashfree/webhook/?$ /api/payments/cashfree.php?action=webhook [QSA,L]
  RewriteRule ^api/payments/webhook/?$ /api/payments/cashfree.php?action=webhook [QSA,L]
  RewriteRule ^api/admin/cashfree-config/?$ /api/payments/cashfree.php?action=admin-config [QSA,L]

  # Serve existing physical files and directories directly
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Admin & Media API routes on Hostinger Apache
  RewriteRule ^api/admin/auth-status/?$ /api/admin/auth-status.php [QSA,L]
  RewriteRule ^api/admin/setup-password/?$ /api/admin/setup-password.php [QSA,L]
  RewriteRule ^api/admin/login/?$ /api/admin/login.php [QSA,L]
  RewriteRule ^api/admin/verify-session/?$ /api/admin/verify-session.php [QSA,L]
  RewriteRule ^api/admin/logout/?$ /api/admin/logout.php [QSA,L]
  RewriteRule ^api/admin/sms-config/?$ /api/admin/sms-config.php [QSA,L]
  RewriteRule ^api/admin/test-sms/?$ /api/admin/sms-config.php?action=test [QSA,L]
  RewriteRule ^api/admin/whatsapp-status/?$ /api/admin/whatsapp-status.php [QSA,L]
  RewriteRule ^api/admin/test-whatsapp/?$ /api/admin/whatsapp-status.php?action=test [QSA,L]
  RewriteRule ^api/videos/upload/?$ /api/videos/upload.php [QSA,L]

  # Media and asset files must never fall back to index.html (return 404 instead of HTML)
  RewriteCond %{REQUEST_URI} \.(mp4|webm|ogv|mov|jpg|jpeg|png|gif|webp|svg|ico|css|js|json|woff|woff2|ttf|eot)$ [NC]
  RewriteRule .* - [R=404,L]

  # API requests must NEVER fall back to index.html (return 404 instead of HTML)
  RewriteCond %{REQUEST_URI} ^/api/ [NC]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^api/.* - [R=404,L]

  # Direct pass for index.html
  RewriteRule ^index\.html$ - [L]

  # Route all other routes to index.html SPA
  RewriteRule . /index.html [L]
</IfModule>
