# VIDHYAA Jewellery Studio Environment Configuration
# Default configurations are built-in for local development and cloud preview.
# Optional overrides:
PORT=3000

# Real SMS OTP Gateway Configuration (Indian & Global numbers)
# Choose one of the following providers:
# 1. Fast2SMS (Indian Instant OTP SMS Gateway):
# FAST2SMS_API_KEY=your_fast2sms_api_key_here

# 2. MSG91 (Indian DLT-approved SMS Gateway):
# MSG91_AUTH_KEY=your_msg91_auth_key_here
# MSG91_TEMPLATE_ID=your_msg91_otp_template_id_here

# 3. Twilio SMS:
# TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
# TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
# TWILIO_PHONE_NUMBER=your_twilio_sender_phone_number_here

# 4. Cashfree Payments Gateway (Credit / Debit Card Checkout)
# Mode: SANDBOX for test card transactions, PRODUCTION for live payments
CASHFREE_APP_ID=your_cashfree_app_id_here
CASHFREE_SECRET_KEY=your_cashfree_secret_key_here
CASHFREE_ENV=SANDBOX
CASHFREE_API_VERSION=2023-08-01
